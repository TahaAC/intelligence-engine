// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Australian lottery draws — supports multiple games
// (Powerball: 7 main 1-35 + 1 PB 1-20)
// (Oz Lotto: 7 main 1-47 + 3 supp 1-47)
model Draw {
  id                   Int      @id @default(autoincrement())
  game                 String   @default("powerball") // "powerball" | "oz-lotto"
  drawNumber           Int
  date                 DateTime
  dateLabel            String
  mainNumbers          String   // JSON-serialized array of 7 numbers
  powerball            Int?     // Powerball only (1-20), null for Oz Lotto
  supplementaryNumbers String?  // Oz Lotto only (JSON array of 3 numbers, 1-47)
  source               String   @default("seed") // "seed" | "sync"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([game, drawNumber])
  @@index([game])
}

// Sync log — every sync attempt is recorded here for audit
model SyncLog {
  id           Int      @id @default(autoincrement())
  game         String   @default("powerball") // which game was synced
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  source       String
  drawsFound   Int      @default(0)
  drawsAdded   Int      @default(0)
  status       String   @default("running") // "running" | "success" | "error"
  error        String?
}
